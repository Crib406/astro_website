---
/*
  Grundlayout: Kopf, Vorschau-Banner, Header, <main> (Slot),
  Footer und das JS-Bündel.

  Seitendaten kommen als Props; die Routen holen sie mit pageProps(entry)
  bzw. postProps(entry) aus src/lib/pages.ts, zum Beispiel:

    <BaseLayout {...pageProps(entry)}>
*/
import Head from '../components/Head.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getJsBundle } from '../lib/bundles';
import { lang, permalinkFromUrl } from '../lib/site';
import type { BaseLayoutProps } from '../lib/pages';

type Props = BaseLayoutProps;

const {
  title,
  description,
  seoTitle,
  kind = 'page',
  section,
  jsonld,
  date,
  lastmod,
  image,
  breadcrumb = false,
} = Astro.props;
const permalink = Astro.props.permalink ?? permalinkFromUrl(Astro.url);

const page = {
  title,
  description,
  isHome: kind === 'home',
  isPost: section === 'blog' && kind === 'page',
  permalink,
  lastmod,
  date,
  image,
  jsonld,
};
const js = await getJsBundle();
---
<!DOCTYPE html>
<html lang={lang}>

  <Head page={page} seoTitle={seoTitle} kind={kind} breadcrumb={breadcrumb} />

  <body>

    <PreviewBanner />

    <Header />

    <main>
      <slot />
    </main>
    <br>
    <Footer />

    <script is:inline defer src={js.href}></script>
  </body>

</html>
