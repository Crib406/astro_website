---
/* Port von hugo/layouts/kontakt/list.html: Breadcrumb + Rohinhalt (kein Markdown-Rendering) */
import { getPage, pageProps } from '../../lib/pages';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const entry = await getPage('kontakt');
const { data } = entry;
---
<BaseLayout {...pageProps(entry)}>

  <Breadcrumb pageTitle={data.title} />

  <Fragment set:html={entry.body} />

</BaseLayout>
