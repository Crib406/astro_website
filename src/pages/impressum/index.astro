---
/* Impressum: Breadcrumb + Rahmenmarkup,
   der Impressums-/Datenschutztext steht als Rohtext in src/content/pages/impressum.md */
import { getPage, pageProps } from '../../lib/pages';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const entry = await getPage('impressum');
const { data } = entry;
---
<BaseLayout {...pageProps(entry)}>

  <Breadcrumb pageTitle={data.title} />

  <div class="blog-classic-area-wrapper tmp-section-gap">
    <div class="container">
      <div class="row">
        <div class="col-lg-10 offset-lg-1">
          {/* legal-page begrenzt die Spaltenbreite (siehe _modern-refresh.scss). */}
          <div class="blog-details-left-area legal-page">

            <Fragment set:html={entry.body} />

          </div>
        </div>
      </div>
    </div>
  </div>

</BaseLayout>
