---
import { blogPublic, relUrl } from '../lib/site';
import { pagePath } from '../lib/routes';

const home = relUrl(pagePath('home'));
const about = relUrl(pagePath('about'));
const meinWeg = relUrl(pagePath('mein-weg'));
const kontakt = relUrl(pagePath('kontakt'));
const blog = relUrl(pagePath('blog'));

// Menüeinträge zentral: Desktop- und Mobilmenü zeichnen dieselbe Liste.
const items = [
  { href: home, label: 'Start' },
  { href: about, label: 'Über mich' },
  { href: meinWeg, label: 'Mein Weg' },
  ...(blogPublic ? [{ href: blog, label: 'Blog' }] : []),
  { href: kontakt, label: 'Kontakt' },
];

// Aktuelle Seite serverseitig (base-fähig, mit oder ohne abschließenden Schrägstrich).
// Die Startseite nur bei exakter Übereinstimmung, alle anderen auch für Unterseiten
// (Blogbeitrag -> "Blog", sofern der Blog im Menü steht).
const slash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const here = slash(Astro.url.pathname);
const isCurrent = (href: string) =>
  href === home ? here === home : here.startsWith(slash(href));
---
<!-- tpm-header-area start -->
<header class="tmp-header-area-start header-one header--sticky header--transparent">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div class="header-content">
          <div class="logo">
            <a href={home}>
              <p><strong>Christoph B. Reimann</strong></p>
            </a>
          </div>

          <nav class="tmp-mainmenu-nav d-none d-xl-block">
            <ul class="tmp-mainmenu">
        {items.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
          </nav>

          <div class="actions-area">
            <div class="tmp-side-collups-area d-block d-xl-none">
              <button class="tmp-menu-bars humberger_menu_active" aria-label="Menü öffnen">
                <i class="fa-regular fa-bars-staggered"></i>
              </button>
            </div>
          </div>

        </div> <!-- .header-content -->
      </div>
    </div>
  </div>
</header>
<!-- tpm-header-area end -->

<!-- mobile menu -->
<div class="d-block d-xl-none">
  <div class="tmp-popup-mobile-menu">
    <div class="inner">
      <div class="header-top">
        <div class="logo">
          <a href={home}>
            <p><strong>Christoph B. Reimann</strong></p>
          </a>
        </div>
        <div class="close-menu">
          <button class="close-button tmp-round-action-btn" aria-label="Menü schließen">
            <i class="fa-sharp fa-light fa-xmark"></i>
          </button>
        </div>
      </div>

      <ul class="tmp-mainmenu">
        <li><a href={home}>Start</a></li>
        <li class="has-dropdown">
          <a href="#">Über mich
            <i class="fa-regular fa-chevron-down"></i>
          </a>
          <ul class="submenu">
            <li><a href={about}>Über mich</a></li>
            <li><a href={meinWeg}>Mein Weg</a></li>
          </ul>
        </li>
        {blogPublic && <li><a href={blog}>Blog</a></li>}
      </ul>

      <div class="social-wrapper mt--40">
        <div class="social-link">
          <a href="https://www.linkedin.com/in/christoph-b-reimann-192328227/" target="_blank" rel="noopener" aria-label="LinkedIn-Profil von Christoph B. Reimann">
            <i class="fa-brands fa-linkedin"></i>
          </a>
        </div>
      </div>

    </div>
  </div>
</div>
<!-- mobile menu end -->
