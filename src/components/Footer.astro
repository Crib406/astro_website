---
import { blogPublic, relUrl } from '../lib/site';
import { pagePath } from '../lib/routes';
import ScrollToTop from './ScrollToTop.astro';
---
<!-- Start Footer Area -->
<footer class="footer-area footer-style-two-wrapper bg-color-footer bg_images tmp-section-gap">
  <div class="container">
    <div class="footer-main footer-style-two">
      <div class="row g-5">
        {/* Spaltenbreiten von main übernommen (5+3+4 = 12), Inhalt von hier:
            das Zitat statt der Wiederholung des Untertitels aus dem Hero. */}
        <div class="col-lg-5 col-md-12">
          <div class="single-footer-wrapper border-right mr--20">
            <h2 class="ft-title">Im Kern</h2>
            <p class="footer-quote">Ich spreche einfach gerne mit Menschen. Über Austausch freue ich mich jederzeit.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6 col-sm-6">
          <div class="quick-link-wrap">
            <h2 class="ft-title">Quick Link</h2>
            <ul class="ft-link tmp-scroll-trigger animation-order-1 tmp-link-animation">
              <li><a href={relUrl(pagePath('about'))}>Über mich</a></li>
              <li><a href={relUrl(pagePath('mein-weg'))}>Mein Weg</a></li>
              <li><a href={relUrl(pagePath('kontakt'))}>Kontakt</a></li>
              {blogPublic && <li><a href={relUrl(pagePath('blog'))}>Blog</a></li>}
              <li><a href={relUrl(pagePath('impressum'))}>Impressum &amp; Datenschutz</a></li>
            </ul>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-6">
          <div class="single-footer-wrapper contact-wrap">
            {/* h2 statt h5: die Footer-Überschriften stehen auf einer Ebene
                mit den Abschnitten der Seite, nicht vier darunter. */}
            <h2 class="ft-title">Kontakt</h2>
            <ul class="ft-link tmp-scroll-trigger animation-order-1 tmp-link-animation">
              <li>
                <span class="ft-icon"><i class="fa-solid fa-location-dot"></i></span>
                Bad Harzburg (Harz)
              </li>
              <li>
                <span class="ft-icon"><i class="fa-solid fa-envelope"></i></span>
                <a href="mailto:hello@creimann.cc">hello@creimann.cc</a>
              </li>
            </ul>
            <div class="social-link footer">
              <a href="https://www.linkedin.com/in/christoph-b-reimann-192328227/" target="_blank" rel="noopener" aria-label="LinkedIn-Profil von Christoph B. Reimann">
                <i class="fa-brands fa-linkedin-in"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<div class="copyright-area-one">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div class="main-wrapper tmp-scroll-trigger animation-order-1">
          <p class="copy-right-para">
            © Christoph B. Reimann - Bad Harzburg (Harz)
            <script is:inline>document.write(new Date().getFullYear())</script>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<ScrollToTop />
